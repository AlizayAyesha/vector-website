# Vector website environment variables. NAMES ONLY: never commit values.
# Set them in Vercel → Project → Settings → Environment Variables (Preview first, test mode).

# --- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_INDEXABLE=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CANONICAL_ORIGIN=
NEXT_PUBLIC_SUBSCRIBE_ENDPOINT=

# --- Sign-in (Supabase Auth; same names as Vector 2.0 apps/web) -----------
# Both required. Without them /login shows "Sign-in is not configured in this environment".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Payments (Stripe) ----------------------------------------------------
# Embedded checkout UI appears only when sign-in AND this publishable key are set.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Server only. Checkout API answers 503 "Payments not configured" unless all three are set.
VECTOR_BILLING_CHECKOUT_ENABLED=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One Stripe recurring price id per offered plan + period (amounts must match content/pricing.json).
STRIPE_PRICE_GO_MONTHLY=
STRIPE_PRICE_GO_QUARTERLY=
STRIPE_PRICE_GO_YEARLY=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_QUARTERLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_QUARTERLY=
STRIPE_PRICE_PRO_ADVANCED_MONTHLY=
STRIPE_PRICE_PRO_ADVANCED_QUARTERLY=
STRIPE_PRICE_PRO_MAX_MONTHLY=
STRIPE_PRICE_ULTRA_MONTHLY=
